---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Beispiel Heizungsbau GmbH | Wärmepumpen Bochum" description="Wärmepumpen, Heiztechnik und Service in Bochum von Beispiel Heizungsbau GmbH">
    <section class="hero relative isolate overflow-hidden">
        <img
            src="/images/hero-waermepumpe.jpg"
            alt="Handwerker installiert und wartet eine Wärmepumpen-Außeneinheit"
            width="1920"
            height="1587"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="hero-overlay absolute inset-0"></div>

        <div class="relative max-w-6xl mx-auto px-6 py-24 lg:py-32 min-h-[560px] lg:min-h-[640px] grid lg:grid-cols-[1.6fr_420px] gap-12 items-end">
            <div class="reveal">
                <p class="text-sm uppercase tracking-widest text-white/80 font-medium">Beispiel Heizungsbau GmbH</p>
                <h1 class="mt-4 text-white">Wärmepumpen, Heizungsservice und Energieberatung in Bochum</h1>
                <p class="mt-6 text-white/85 max-w-2xl">Wir planen, liefern und warten moderne Wärmepumpen für Einfamilienhäuser, Mehrfamilienhäuser und Gewerbe. Ihr Ansprechpartner in Bochum für effiziente Heiztechnik und schnelle Reparaturen.</p>
                <div class="mt-8 flex flex-wrap gap-4">
                    <Button variant="primary" size="lg" href="#kontakt">Jetzt anfragen</Button>
                    <Button variant="secondary" size="lg" href="#leistungen">Leistungen ansehen</Button>
                </div>
            </div>

            <aside class="space-y-4">
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Standort</strong>
                    <p class="mt-2 text-lg font-medium">Bochum</p>
                </div>
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Telefon</strong>
                    <p class="mt-2 text-lg font-medium">+49 234 123 4567</p>
                </div>
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Service</strong>
                    <p class="mt-2 text-lg font-medium">Wärmepumpen, Heizung, Wartung</p>
                </div>
            </aside>
        </div>
    </section>

    <main class="max-w-6xl mx-auto px-6 py-16">
        <section id="leistungen" class="reveal">
            <h2>Unsere Leistungen</h2>
            <p class="mt-2 text-slate-600">Schwerpunkt Wärmepumpen – dazu Klimaanlagen sowie Wartung und Service für bestehende Anlagen.</p>

            <div class="mt-8 grid lg:grid-cols-[1.4fr_1fr] gap-6 items-start">
                <article class="service-card service-card--featured">
                    <div class="service-card__media aspect-[4/5]">
                        <img
                            src="/images/leistungen-waermepumpen.jpg"
                            alt="Techniker bei der Installation und Prüfung einer Wärmepumpe"
                            width="1200"
                            height="2133"
                            loading="lazy"
                        />
                        <div class="service-card__tint"></div>
                    </div>
                    <div class="service-card__body">
                        <span class="service-card__tag">Unser Schwerpunkt</span>
                        <h3>Wärmepumpen</h3>
                        <p class="mt-3">Beratung, Planung, Lieferung und Installation von Luft/Wasser- und Erdreich-Wärmepumpen für Neubau und Modernisierung.</p>
                    </div>
                </article>

                <div class="grid gap-6">
                    <article class="service-card">
                        <div class="service-card__media aspect-[4/3]">
                            <img
                                src="/images/leistungen-klimaanlagen.jpg"
                                alt="Techniker prüft den Kältemitteldruck einer Klimaanlage mit einem Manometer"
                                width="1000"
                                height="1430"
                                loading="lazy"
                            />
                            <div class="service-card__tint"></div>
                        </div>
                        <div class="service-card__body">
                            <h3>Klimaanlagen</h3>
                            <p class="mt-3">Planung, Installation und Wartung von Split-Klimaanlagen für Wohn- und Gewerberäume.</p>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-card__media aspect-[4/3]">
                            <img
                                src="/images/leistungen-service.jpg"
                                alt="Techniker führt eine Dichtheitsprüfung an einer Außeneinheit durch"
                                width="1000"
                                height="1500"
                                loading="lazy"
                            />
                            <div class="service-card__tint"></div>
                        </div>
                        <div class="service-card__body">
                            <h3>Wartung & Service</h3>
                            <p class="mt-3">Regelmäßige Inspektion, Wartung und schnelle Hilfe bei Störungen – auch für bestehende Wärmepumpenanlagen.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Referenzen / Aktuelle Projekte -->
        <section id="referenzen" class="mt-16 reveal">
            <h2>Referenzen / Aktuelle Projekte</h2>
            <p class="mt-2 text-slate-600">Auszug aus aktuellen Projekten — Platzhalterinhalte, Kundenbilder später ersetzen.</p>

            <div class="mt-8 grid sm:grid-cols-2 md:grid-cols-3 gap-6">
                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <!-- placeholder image/icon -->
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5 17l4-10 4 6 6-8 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Wärmepumpen‑Installation Einfamilienhaus, Bochum</h3>
                    <p class="mt-2 text-slate-600">Neubau: Installation einer Luft/Wasser‑Wärmepumpe, Inbetriebnahme und Einweisung.</p>
                </article>

                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5 22h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Klimatisierung Bürogebäude, Bochum</h3>
                    <p class="mt-2 text-slate-600">Modernisierung mit mehreren Split‑Klimaanlagen und zentraler Steuerung.</p>
                </article>

                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Photovoltaik‑Dachanlage, Bochum</h3>
                    <p class="mt-2 text-slate-600">20 kWp PV‑Anlage mit Einspeise- und Eigenverbrauchsoptimierung.</p>
                </article>
            </div>
        </section>

        <section class="mt-16 bg-slate-50 p-8 rounded-2xl reveal">
            <h2>Warum Wärmepumpen?</h2>
            <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
                <li>Günstigere Betriebskosten im Vergleich zu Öl und Gas</li>
                <li>Förderfähig durch BAFA und KfW</li>
                <li>Passend für Neubau und energieeffiziente Sanierung</li>
            </ul>
            <p class="mt-4">Wir begleiten Sie von der ersten Bestandsaufnahme bis zur Übergabe der fertigen Anlage.</p>
        </section>

        <section id="kontakt" class="mt-16 reveal">
            <h2>Kontakt</h2>
            <p class="mt-3">Schreiben Sie uns eine Nachricht oder rufen Sie an. Wir melden uns schnell mit einem ersten Angebot für Ihre Wärmepumpe in Bochum.</p>
            <div class="mt-6 grid md:grid-cols-3 gap-4">
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">Telefon</strong>
                    <p class="mt-2 font-medium">+49 234 123 4567</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">E-Mail</strong>
                    <p class="mt-2 font-medium">info@beispiel-heizungsbau.de</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">Adresse</strong>
                    <p class="mt-2 font-medium">Musterstraße 1, 44787 Bochum</p>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .hero-overlay {
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--gray-900) 10%, transparent) 0%,
            color-mix(in srgb, var(--gray-900) 45%, transparent) 55%,
            color-mix(in srgb, var(--gray-900) 82%, transparent) 100%
        );
    }

    .hero-card {
        background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);
        backdrop-filter: blur(8px);
        border-radius: var(--radius-xl);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-default);
        transition: transform 200ms ease, box-shadow 200ms ease;
    }

    .hero-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .service-card {
        display: flex;
        flex-direction: column;
        background: var(--color-bg-surface);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-default);
        transition: transform 220ms ease, box-shadow 220ms ease;
    }

    .service-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .service-card--featured {
        height: 100%;
    }

    .service-card__media {
        position: relative;
        overflow: hidden;
    }

    .service-card__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms ease;
    }

    .service-card:hover .service-card__media img {
        transform: scale(1.06);
    }

    .service-card__tint {
        position: absolute;
        inset: 0;
        background: var(--color-brand-primary);
        mix-blend-mode: color;
        opacity: 0.55;
        transition: opacity 300ms ease;
    }

    .service-card:hover .service-card__tint {
        opacity: 0.3;
    }

    .service-card__body {
        padding: var(--spacing-lg);
    }

    .service-card__tag {
        display: inline-block;
        font-size: var(--text-eyebrow-size);
        letter-spacing: var(--text-eyebrow-letter-spacing);
        font-weight: var(--text-eyebrow-weight);
        text-transform: uppercase;
        color: var(--color-brand-primary);
        background: var(--color-bg-info-subtle);
        padding: 2px var(--spacing-sm);
        border-radius: var(--radius-full);
        margin-bottom: var(--spacing-sm);
    }
</style>
