---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout title="Beispiel Heizungsbau GmbH | Wärmepumpen Bochum" description="Wärmepumpen, Heiztechnik und Service in Bochum von Beispiel Heizungsbau GmbH">
    <section class="hero relative isolate overflow-hidden">
        <img
            src="/images/hero-waermepumpe.jpg"
            alt="Handwerker installiert und wartet eine Wärmepumpen-Außeneinheit"
            width="1920"
            height="1587"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="hero-overlay absolute inset-0"></div>

        <div class="relative max-w-6xl mx-auto px-6 py-24 lg:py-32 min-h-[560px] lg:min-h-[640px] grid lg:grid-cols-[1.6fr_420px] gap-12 items-end">
            <div class="reveal">
                <p class="text-sm uppercase tracking-widest text-white/80 font-medium">Beispiel Heizungsbau GmbH</p>
                <h1 class="mt-4 text-white">Wärmepumpen, Heizungsservice und Energieberatung in Bochum</h1>
                <p class="mt-6 text-white/85 max-w-2xl">Wir planen, liefern und warten moderne Wärmepumpen für Einfamilienhäuser, Mehrfamilienhäuser und Gewerbe. Ihr Ansprechpartner in Bochum für effiziente Heiztechnik und schnelle Reparaturen.</p>
                <div class="mt-8 flex flex-wrap gap-4">
                    <Button variant="primary" size="lg" href="#kontakt">Jetzt anfragen</Button>
                    <Button variant="secondary" size="lg" href="#leistungen">Leistungen ansehen</Button>
                </div>
            </div>

            <aside class="space-y-4">
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Standort</strong>
                    <p class="mt-2 text-lg font-medium">Bochum</p>
                </div>
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Telefon</strong>
                    <p class="mt-2 text-lg font-medium">+49 234 123 4567</p>
                </div>
                <div class="hero-card reveal">
                    <strong class="block text-sm text-slate-700">Service</strong>
                    <p class="mt-2 text-lg font-medium">Wärmepumpen, Heizung, Wartung</p>
                </div>
            </aside>
        </div>
    </section>

    <section class="story reveal" aria-label="Unsere Leistungen im Überblick">
        <div class="mx-auto px-6 lg:px-12 max-w-[1800px]">
            <div class="story-layout">
                <div class="story-media">
                    <p class="story__eyebrow">Von der Beratung bis zur fertigen Anlage</p>
                    <div class="story-media__frame">
                        <svg id="house-svg" viewBox="40 115 720 370" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Schematische Darstellung eines Hauses mit Photovoltaik, Wärmepumpe und Klimaanlage">
                            <!-- Haus (neutral, ändert sich nie) -->
                            <g class="house-base" fill="none" stroke="var(--gray-400)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="60" y1="460" x2="740" y2="460"/>
                                <polygon points="200,260 390,140 580,260"/>
                                <rect x="220" y="260" width="340" height="200"/>
                                <rect x="365" y="360" width="50" height="100"/>
                                <circle cx="405" cy="410" r="2.5" fill="var(--gray-400)"/>
                                <rect x="255" y="310" width="55" height="55"/>
                                <line x1="282.5" y1="310" x2="282.5" y2="365"/>
                                <line x1="255" y1="337.5" x2="310" y2="337.5"/>
                            </g>

                            <!-- Photovoltaik -->
                            <g class="house-feature pv-group" transform="translate(390,150) rotate(30)" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="15" y="15" width="55" height="35"/>
                                <rect x="80" y="15" width="55" height="35"/>
                                <rect x="15" y="58" width="55" height="35"/>
                                <rect x="80" y="58" width="55" height="35"/>
                                <line x1="42.5" y1="15" x2="42.5" y2="50"/>
                                <line x1="107.5" y1="15" x2="107.5" y2="50"/>
                                <line x1="42.5" y1="58" x2="42.5" y2="93"/>
                                <line x1="107.5" y1="58" x2="107.5" y2="93"/>
                                <line x1="15" y1="32.5" x2="70" y2="32.5"/>
                                <line x1="80" y1="32.5" x2="135" y2="32.5"/>
                                <line x1="15" y1="75.5" x2="70" y2="75.5"/>
                                <line x1="80" y1="75.5" x2="135" y2="75.5"/>
                            </g>

                            <!-- Wärmepumpe -->
                            <g class="house-feature wp-group" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect class="wp-box" x="90" y="380" width="100" height="70"/>
                                <rect class="wp-box" x="95" y="450" width="90" height="8"/>
                                <line class="wp-box" x1="98" y1="392" x2="182" y2="392"/>
                                <line class="wp-box" x1="98" y1="404" x2="182" y2="404"/>
                                <line class="wp-box" x1="98" y1="416" x2="182" y2="416"/>
                                <line class="wp-box" x1="98" y1="428" x2="182" y2="428"/>
                                <circle class="wp-fan" cx="140" cy="415" r="16"/>
                                <line class="wp-fan" x1="140" y1="399" x2="140" y2="431"/>
                                <line class="wp-fan" x1="124" y1="415" x2="156" y2="415"/>
                                <polyline class="wp-box" points="190,392 210,392 210,420 220,420"/>
                            </g>

                            <!-- Klimaanlage -->
                            <g class="house-feature ac-group" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="480" y="300" width="55" height="35"/>
                                <line x1="490" y1="335" x2="490" y2="350"/>
                                <line x1="525" y1="335" x2="525" y2="350"/>
                                <line x1="488" y1="310" x2="527" y2="310"/>
                                <line x1="488" y1="320" x2="527" y2="320"/>
                                <line x1="507" y1="350" x2="507" y2="460"/>
                            </g>
                        </svg>
                    </div>
                    <div class="story-dots" aria-hidden="true">
                        <span class="story-dot is-active" data-dot="photovoltaik"></span>
                        <span class="story-dot" data-dot="waermepumpen"></span>
                        <span class="story-dot" data-dot="klimaanlagen"></span>
                    </div>
                </div>

                <div class="story-content">
                    <div class="story-block is-active" data-story="photovoltaik">
                        <span class="story-block__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#facc15" stroke-width="1.6">
                                <circle cx="12" cy="12" r="3.2" stroke-width="1.8"/>
                                <path d="M12 2v2" stroke-linecap="round"/>
                                <path d="M12 20v2" stroke-linecap="round"/>
                                <path d="M4.93 4.93l1.41 1.41" stroke-linecap="round"/>
                                <path d="M17.66 17.66l1.41 1.41" stroke-linecap="round"/>
                                <path d="M2 12h2" stroke-linecap="round"/>
                                <path d="M20 12h2" stroke-linecap="round"/>
                                <path d="M4.93 19.07l1.41-1.41" stroke-linecap="round"/>
                                <path d="M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <h3>Photovoltaik</h3>
                        <p>Konzeption und Installation von PV-Anlagen zur eigenen Stromerzeugung. Wir prüfen Dachfläche, Ausrichtung und Verschattung und berechnen daraus die wirtschaftlich sinnvolle Anlagengröße. Montage und Wechselrichter-Integration übernehmen wir komplett – nach der Inbetriebnahme behalten wir Ertrag und Funktion Ihrer Anlage im laufenden Monitoring im Blick.</p>
                    </div>

                    <div class="story-block" data-story="waermepumpen">
                        <span class="story-block__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 9h13m0 0-3-3m3 3-3 3" stroke="var(--error-500)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M20 15H7m0 0 3 3m-3-3 3-3" stroke="var(--color-brand-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                        <h3>Wärmepumpen</h3>
                        <p>Beratung, Planung und Installation energieeffizienter Wärmepumpen für Neubau und Modernisierung. Wir analysieren Ihr Gebäude, ermitteln den passenden Anlagentyp – Luft/Wasser oder Erdreich – und legen die Größe nach Ihrem tatsächlichen Wärmebedarf aus. Zur Finanzierung beraten wir zu Fördermitteln wie BAFA und KfW und übernehmen auf Wunsch auch Inbetriebnahme und Einweisung.</p>
                    </div>

                    <div class="story-block" data-story="klimaanlagen">
                        <span class="story-block__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="var(--cyan-500)" stroke-width="1.6" stroke-linecap="round">
                                <path d="M12 3v18"/>
                                <path d="M4.5 7.5l15 9"/>
                                <path d="M19.5 7.5l-15 9"/>
                                <path d="M12 3l-2 2M12 3l2 2"/>
                                <path d="M12 21l-2-2M12 21l2-2"/>
                                <path d="M4.5 7.5l2.7-.7M4.5 7.5l.7 2.7"/>
                                <path d="M19.5 16.5l-2.7.7M19.5 16.5l-.7-2.7"/>
                                <path d="M19.5 7.5l-2.7.7M19.5 7.5l-.7 2.7"/>
                                <path d="M4.5 16.5l2.7-.7M4.5 16.5l.7-2.7"/>
                            </svg>
                        </span>
                        <h3>Klimaanlagen</h3>
                        <p>Planung und Einbau von Klimaanlagen für Wohn- und Gewerberäume. Ob einzelne Split-Klimaanlage im Schlafzimmer oder mehrere Innengeräte mit zentraler Steuerung im Bürogebäude – wir beraten zur passenden Anlagengröße und zum Kältemittel. Nach der fachgerechten Installation sorgen Serviceverträge inklusive Notdienst dafür, dass Ihre Anlage zuverlässig läuft.</p>
                    </div>
                </div>
            </div>

            <p class="story__closing reveal">Wir kümmern uns um alles – von der ersten Planung bis zur laufenden Wartung.</p>
        </div>
    </section>

    <main class="max-w-6xl mx-auto px-6 py-10">
        <section id="leistungen" class="reveal">
            <h2>Unsere Leistungen</h2>
            <p class="mt-2 text-slate-600">Schwerpunkt Wärmepumpen – dazu Klimaanlagen sowie Wartung und Service für bestehende Anlagen.</p>

            <div class="mt-6 grid lg:grid-cols-[1.4fr_1fr] gap-5 items-start">
                <article class="service-card service-card--featured">
                    <div class="service-card__media aspect-[4/4.2]">
                        <img
                            src="/images/leistungen-waermepumpen.jpg"
                            alt="Techniker bei der Installation und Prüfung einer Wärmepumpe"
                            width="1200"
                            height="2133"
                            loading="lazy"
                        />
                        <div class="service-card__tint"></div>
                    </div>
                    <div class="service-card__body">
                        <span class="service-card__tag">Unser Schwerpunkt</span>
                        <h3>Wärmepumpen</h3>
                        <p class="mt-3">Beratung, Planung, Lieferung und Installation von Luft/Wasser- und Erdreich-Wärmepumpen für Neubau und Modernisierung.</p>
                    </div>
                </article>

                <div class="grid gap-6">
                    <article class="service-card">
                        <div class="service-card__media aspect-[4/3]">
                            <img
                                src="/images/leistungen-klimaanlagen.jpg"
                                alt="Techniker prüft den Kältemitteldruck einer Klimaanlage mit einem Manometer"
                                width="1000"
                                height="1430"
                                loading="lazy"
                            />
                            <div class="service-card__tint"></div>
                        </div>
                        <div class="service-card__body">
                            <h3>Klimaanlagen</h3>
                            <p class="mt-3">Planung, Installation und Wartung von Split-Klimaanlagen für Wohn- und Gewerberäume.</p>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-card__media aspect-[4/3]">
                            <img
                                src="/images/leistungen-service.jpg"
                                alt="Techniker führt eine Dichtheitsprüfung an einer Außeneinheit durch"
                                width="1000"
                                height="1500"
                                loading="lazy"
                            />
                            <div class="service-card__tint"></div>
                        </div>
                        <div class="service-card__body">
                            <h3>Wartung & Service</h3>
                            <p class="mt-3">Regelmäßige Inspektion, Wartung und schnelle Hilfe bei Störungen – auch für bestehende Wärmepumpenanlagen.</p>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- Referenzen / Aktuelle Projekte -->
        <section id="referenzen" class="mt-16 reveal">
            <h2>Referenzen / Aktuelle Projekte</h2>
            <p class="mt-2 text-slate-600">Auszug aus aktuellen Projekten — Platzhalterinhalte, Kundenbilder später ersetzen.</p>

            <div class="mt-8 grid sm:grid-cols-2 md:grid-cols-3 gap-6">
                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <!-- placeholder image/icon -->
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5 17l4-10 4 6 6-8 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Wärmepumpen‑Installation Einfamilienhaus, Bochum</h3>
                    <p class="mt-2 text-slate-600">Neubau: Installation einer Luft/Wasser‑Wärmepumpe, Inbetriebnahme und Einweisung.</p>
                </article>

                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M5 22h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Klimatisierung Bürogebäude, Bochum</h3>
                    <p class="mt-2 text-slate-600">Modernisierung mit mehreren Split‑Klimaanlagen und zentraler Steuerung.</p>
                </article>

                <article class="bg-white p-5 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <div class="h-40 bg-slate-100 rounded-md flex items-center justify-center">
                        <svg class="w-14 h-14 text-slate-400" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M3 21h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    </div>
                    <h3 class="mt-4 text-lg font-semibold">Photovoltaik‑Dachanlage, Bochum</h3>
                    <p class="mt-2 text-slate-600">20 kWp PV‑Anlage mit Einspeise- und Eigenverbrauchsoptimierung.</p>
                </article>
            </div>
        </section>

        <section class="mt-16 bg-slate-50 p-8 rounded-2xl reveal">
            <h2>Warum Wärmepumpen?</h2>
            <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
                <li>Günstigere Betriebskosten im Vergleich zu Öl und Gas</li>
                <li>Förderfähig durch BAFA und KfW</li>
                <li>Passend für Neubau und energieeffiziente Sanierung</li>
            </ul>
            <p class="mt-4">Wir begleiten Sie von der ersten Bestandsaufnahme bis zur Übergabe der fertigen Anlage.</p>
        </section>

        <section id="kontakt" class="mt-16 reveal">
            <h2>Kontakt</h2>
            <p class="mt-3">Schreiben Sie uns eine Nachricht oder rufen Sie an. Wir melden uns schnell mit einem ersten Angebot für Ihre Wärmepumpe in Bochum.</p>
            <div class="mt-6 grid md:grid-cols-3 gap-4">
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">Telefon</strong>
                    <p class="mt-2 font-medium">+49 234 123 4567</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">E-Mail</strong>
                    <p class="mt-2 font-medium">info@beispiel-heizungsbau.de</p>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-soft-lg hover:shadow-xl transition hover:-translate-y-1">
                    <strong class="text-sm text-slate-700">Adresse</strong>
                    <p class="mt-2 font-medium">Musterstraße 1, 44787 Bochum</p>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .hero-overlay {
        background: linear-gradient(
            180deg,
            color-mix(in srgb, var(--gray-900) 10%, transparent) 0%,
            color-mix(in srgb, var(--gray-900) 45%, transparent) 55%,
            color-mix(in srgb, var(--gray-900) 82%, transparent) 100%
        );
    }

    .hero-card {
        background: color-mix(in srgb, var(--color-bg-surface) 92%, transparent);
        backdrop-filter: blur(8px);
        border-radius: var(--radius-xl);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-default);
        transition: transform 200ms ease, box-shadow 200ms ease;
    }

    .hero-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .service-card {
        display: flex;
        flex-direction: column;
        background: var(--color-bg-surface);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-default);
        transition: transform 220ms ease, box-shadow 220ms ease;
    }

    .service-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
    }

    .service-card--featured {
        height: 100%;
    }

    .service-card__media {
        position: relative;
        overflow: hidden;
    }

    .service-card__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 500ms ease;
    }

    .service-card:hover .service-card__media img {
        transform: scale(1.06);
    }

    .service-card__tint {
        position: absolute;
        inset: 0;
        background: var(--color-brand-primary);
        mix-blend-mode: color;
        opacity: 0.55;
        transition: opacity 300ms ease;
    }

    .service-card:hover .service-card__tint {
        opacity: 0.3;
    }

    .service-card__body {
        padding: var(--spacing-lg);
    }

    .service-card__tag {
        display: inline-block;
        font-size: var(--text-eyebrow-size);
        letter-spacing: var(--text-eyebrow-letter-spacing);
        font-weight: var(--text-eyebrow-weight);
        text-transform: uppercase;
        color: var(--color-brand-primary);
        background: var(--color-bg-info-subtle);
        padding: 2px var(--spacing-sm);
        border-radius: var(--radius-full);
        margin-bottom: var(--spacing-sm);
    }

    /* Leistungs-Story: vertikaler Scroll-Übergang zwischen Hero und Leistungen */
    .story {
        padding: var(--spacing-3xl) 0;
    }

    .story__eyebrow {
        font-size: var(--text-eyebrow-size);
        letter-spacing: var(--text-eyebrow-letter-spacing);
        font-weight: var(--text-eyebrow-weight);
        text-transform: uppercase;
        color: var(--color-text-muted);
        text-align: center;
        margin-bottom: var(--spacing-2xl);
    }

    .story-layout {
        display: grid;
        gap: var(--spacing-2xl);
    }

    .story-media {
        margin-bottom: var(--spacing-xl);
    }

    .story-media__frame {
        position: relative;
        aspect-ratio: 720 / 370;
        border-radius: var(--radius-xl);
        overflow: hidden;
        background: var(--color-bg-surface);
        box-shadow: var(--shadow-default);
    }

    #house-svg {
        width: 100%;
        height: 100%;
    }

    .story-dots {
        display: flex;
        gap: var(--spacing-sm);
        justify-content: center;
        margin-top: var(--spacing-lg);
    }

    .story-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: var(--radius-full);
        background: var(--color-border-default);
        transition: background-color 300ms ease, transform 300ms ease;
    }

    .story-dot.is-active {
        background: var(--color-brand-primary);
        transform: scale(1.4);
    }

    .story-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3xl);
    }

    .story-block {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        opacity: 0.45;
        transform: translateY(6px);
        transition: opacity 650ms cubic-bezier(.2,.9,.25,1), transform 650ms cubic-bezier(.2,.9,.25,1);
    }

    .story-block.is-active {
        opacity: 1;
        transform: translateY(0);
    }

    .story__closing {
        margin-top: var(--spacing-3xl);
        text-align: center;
        font-size: var(--text-h3-size);
        font-weight: 600;
        color: var(--color-text-primary);
        max-width: 40rem;
        margin-left: auto;
        margin-right: auto;
    }

    .story-block__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-full);
        background: var(--color-bg-surface);
        box-shadow: var(--shadow-default);
        margin-bottom: var(--spacing-xs);
    }

    .story-block__icon svg {
        width: 1.4rem;
        height: 1.4rem;
    }

    .story-block h3 {
        margin: 0;
        font-size: var(--text-h3-size);
        font-weight: 700;
    }

    .story-block p {
        margin: 0;
        max-width: 34rem;
        font-size: var(--text-body-size);
        line-height: var(--text-body-line-height);
    }

    .house-feature {
        color: var(--gray-400);
        transition: color 650ms ease;
    }

    .pv-group.is-active {
        color: #facc15;
    }

    .wp-group .wp-box,
    .wp-group .wp-fan {
        transition: color 650ms ease;
    }

    .wp-group.is-active .wp-box {
        color: var(--color-brand-primary);
    }

    .wp-group.is-active .wp-fan {
        color: var(--error-500);
    }

    .ac-group.is-active {
        color: var(--cyan-500);
    }

    @media (min-width: 1024px) {
        .story-layout {
            grid-template-columns: 1fr 400px;
            gap: var(--spacing-2xl);
            align-items: start;
        }

        .story-media {
            position: sticky;
            top: 5rem;
            height: calc(100vh - 5rem);
            margin-bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .story-media__frame {
            box-shadow: var(--shadow-hover);
        }

        .story-content {
            gap: 95vh;
            padding: 15vh 0 15vh 1.5rem;
        }
    }

    @media (min-width: 1280px) {
        .story-layout {
            grid-template-columns: 1fr 460px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .story-block,
        .house-feature,
        .wp-group .wp-box,
        .wp-group .wp-fan,
        .story-dot {
            transition: none;
        }
    }
</style>

<script>
    (() => {
        if (typeof window === 'undefined') return;
        const section = document.querySelector('.story');
        const svg = document.getElementById('house-svg');
        if (!section || !svg) return;

        const blocks = Array.from(document.querySelectorAll('.story-block[data-story]'));
        const dots = Array.from(document.querySelectorAll('.story-dot[data-dot]'));
        const pvGroup = svg.querySelector('.pv-group');
        const wpGroup = svg.querySelector('.wp-group');
        const acGroup = svg.querySelector('.ac-group');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Kamera-Stationen im 800x600-Koordinatenraum des Hauses (x, y, width, height)
        // Seitenverhältnis 720:370, enger zugeschnitten als die Vollansicht
        const fullView = { x: 40, y: 115, w: 720, h: 370 };
        const stations = {
            photovoltaik: { x: 180, y: 112, w: 420, h: 216 },
            waermepumpen: { x: 0, y: 338, w: 300, h: 154 },
            klimaanlagen: { x: 357, y: 243, w: 300, h: 154 },
        };

        const lerp = (a, b, t) => a + (b - a) * t;
        const lerpBox = (a, b, t) => ({
            x: lerp(a.x, b.x, t),
            y: lerp(a.y, b.y, t),
            w: lerp(a.w, b.w, t),
            h: lerp(a.h, b.h, t),
        });

        // Halte- und Übergangszonen: Kamera-Position und aktives Element kommen
        // aus derselben Quelle, damit Farbe und Kamera nie auseinanderlaufen.
        const zones = [
            { end: 0.2, hold: 'photovoltaik' },
            { end: 0.35, from: 'photovoltaik', to: 'waermepumpen' },
            { end: 0.55, hold: 'waermepumpen' },
            { end: 0.7, from: 'waermepumpen', to: 'klimaanlagen' },
            { end: 1, hold: 'klimaanlagen' },
        ];

        const getState = (progress) => {
            let start = 0;
            for (const zone of zones) {
                if (progress <= zone.end || zone === zones[zones.length - 1]) {
                    if (zone.hold) {
                        return { box: stations[zone.hold], active: zone.hold };
                    }
                    const t = (progress - start) / (zone.end - start);
                    return {
                        box: lerpBox(stations[zone.from], stations[zone.to], t),
                        active: t < 0.5 ? zone.from : zone.to,
                    };
                }
                start = zone.end;
            }
            return { box: stations.klimaanlagen, active: 'klimaanlagen' };
        };

        const setActive = (key) => {
            blocks.forEach((el) => el.classList.toggle('is-active', el.dataset.story === key));
            dots.forEach((el) => el.classList.toggle('is-active', el.dataset.dot === key));
            pvGroup?.classList.toggle('is-active', key === 'photovoltaik');
            wpGroup?.classList.toggle('is-active', key === 'waermepumpen');
            acGroup?.classList.toggle('is-active', key === 'klimaanlagen');
        };

        let ticking = false;

        const update = () => {
            ticking = false;
            const rect = section.getBoundingClientRect();
            const vh = window.innerHeight;
            const total = rect.height + vh * 0.6;
            const scrolled = vh * 0.85 - rect.top;
            const progress = reduceMotion ? 1 : Math.min(1, Math.max(0, scrolled / total));

            const { box, active } = getState(progress);
            setActive(active);

            if (window.innerWidth >= 1024) {
                svg.setAttribute('viewBox', `${box.x} ${box.y} ${box.w} ${box.h}`);
            } else {
                svg.setAttribute('viewBox', `${fullView.x} ${fullView.y} ${fullView.w} ${fullView.h}`);
            }
        };

        const onScroll = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(update);
        };

        update();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
    })();
</script>
