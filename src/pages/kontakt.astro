---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Input from '../components/Input.astro';
---
<Layout title="Kontakt | Beispiel Heizungsbau GmbH">
  <section class="max-w-5xl mx-auto px-6 py-12 reveal">
    <h1 class="text-3xl font-extrabold">Kontakt</h1>
    <p class="mt-2 text-slate-600">Schreiben Sie uns oder rufen Sie an — wir melden uns schnell.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-[1fr_1.3fr] items-start">
      <div class="bg-white rounded-2xl p-6 shadow-soft-lg">
        <h3 class="font-semibold">Unsere Kontaktdaten</h3>

        <ul class="mt-5 flex flex-col gap-1">
          <li class="contact-row">
            <span class="contact-row__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
            </span>
            <div class="contact-row__text">
              <span class="contact-row__label">Telefon</span>
              <a href="tel:+492341234567" class="contact-row__value">+49 234 123 4567</a>
            </div>
            <button type="button" class="contact-row__copy" data-copy="+49 234 123 4567" aria-label="Telefonnummer kopieren">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 15V6a1 1 0 0 1 1-1h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </li>

          <li class="contact-row">
            <span class="contact-row__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m3.5 6 8.5 6 8.5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <div class="contact-row__text">
              <span class="contact-row__label">E-Mail</span>
              <a href="mailto:info@beispiel-heizungsbau.de" class="contact-row__value">info@beispiel-heizungsbau.de</a>
            </div>
            <button type="button" class="contact-row__copy" data-copy="info@beispiel-heizungsbau.de" aria-label="E-Mail-Adresse kopieren">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 15V6a1 1 0 0 1 1-1h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </li>

          <li class="contact-row">
            <span class="contact-row__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
            <div class="contact-row__text">
              <span class="contact-row__label">Adresse</span>
              <span class="contact-row__value">Musterstraße 1, 44787 Bochum</span>
            </div>
            <button type="button" class="contact-row__copy" data-copy="Musterstraße 1, 44787 Bochum" aria-label="Adresse kopieren">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M5 15V6a1 1 0 0 1 1-1h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </li>
        </ul>

        <p class="contact-copy-feedback" role="status" aria-live="polite"></p>
      </div>

      <form class="bg-white rounded-2xl p-6 shadow-soft-lg flex flex-col gap-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <Input label="Name" name="name" placeholder="Max Mustermann" required />

          <Input label="E-Mail" name="email" type="email" placeholder="max@beispiel.de" required>
            <svg slot="icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="m3.5 6 8.5 6 8.5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </Input>
        </div>

        <Input
          label="Nachricht"
          name="message"
          as="textarea"
          rows={8}
          placeholder="z.B. Wärmepumpe tauschen, Angebot für einen Neubau, Störung an bestehender Anlage …"
          required
        />

        <Button variant="primary" size="md" type="submit">Nachricht senden</Button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .contact-row:last-child {
    border-bottom: none;
  }

  .contact-row__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-bg-info-subtle);
    color: var(--color-brand-primary);
  }

  .contact-row__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .contact-row__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .contact-row__label {
    font-size: var(--text-body-sm-size);
    color: var(--color-text-muted);
  }

  .contact-row__value {
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    overflow-wrap: break-word;
  }

  a.contact-row__value:hover {
    color: var(--color-brand-primary);
  }

  .contact-row__copy {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .contact-row__copy:hover {
    background: var(--color-bg-subtle);
    color: var(--color-brand-primary);
  }

  .contact-row__copy svg {
    width: 1rem;
    height: 1rem;
  }

  .contact-copy-feedback {
    margin: var(--spacing-sm) 0 0;
    min-height: 1.2em;
    font-size: var(--text-body-sm-size);
    color: var(--color-text-success);
  }
</style>

<script>
  document.querySelectorAll('.contact-row__copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const value = button.getAttribute('data-copy');
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const feedback = document.querySelector('.contact-copy-feedback');
        if (feedback) {
          feedback.textContent = `„${value}“ kopiert.`;
          setTimeout(() => {
            if (feedback.textContent === `„${value}“ kopiert.`) feedback.textContent = '';
          }, 2500);
        }
      } catch {
        /* Clipboard-Zugriff nicht verfügbar (z.B. kein HTTPS) – stiller Fallback */
      }
    });
  });
</script>
