---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kontakt | Beispiel Heizungsbau GmbH">
  <section class="max-w-3xl mx-auto px-6 py-12 reveal">
    <h1 class="text-3xl font-extrabold">Kontakt</h1>
    <p class="mt-2 text-slate-600">Schreiben Sie uns oder rufen Sie an — wir melden uns schnell.</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div class="bg-white rounded-2xl p-6 shadow-soft-lg">
        <h3 class="font-semibold">Unsere Kontaktdaten</h3>
        <dl class="mt-4 text-sm text-slate-700">
          <div>
            <dt class="font-medium">Telefon</dt>
            <dd class="mt-1">+49 234 123 4567</dd>
          </div>
          <div class="mt-3">
            <dt class="font-medium">E‑Mail</dt>
            <dd class="mt-1">info@beispiel-heizungsbau.de</dd>
          </div>
          <div class="mt-3">
            <dt class="font-medium">Adresse</dt>
            <dd class="mt-1">Musterstraße 1, 44787 Bochum</dd>
          </div>
        </dl>
      </div>

      <form class="bg-white rounded-2xl p-6 shadow-soft-lg">
        <label class="block text-sm font-medium">Name</label>
        <input class="mt-1 w-full rounded-md border px-3 py-2" />
        <label class="block text-sm font-medium mt-4">E‑Mail</label>
        <input class="mt-1 w-full rounded-md border px-3 py-2" />
        <label class="block text-sm font-medium mt-4">Nachricht</label>
        <textarea class="mt-1 w-full rounded-md border px-3 py-2 h-36"></textarea>
        <button class="mt-4 inline-block bg-brand-primary text-white px-4 py-2 rounded">Nachricht senden</button>
      </form>
    </div>
  </section>
</Layout>
