---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Leistungen | Beispiel Heizungsbau GmbH">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <div class="reveal">
      <h1>Unsere Leistungen</h1>
      <p class="mt-3">Übersicht unserer Kernkompetenzen. Klicke eine Karte für Details.</p>
    </div>

    <div class="mt-8 grid sm:grid-cols-2 md:grid-cols-3 gap-6">
      <!-- Wärmepumpen card -->
      <a href="/leistungen/waermepumpen" class="reveal service-tile block">
        <div class="service-tile__media">
          <img
            src="/images/waermepumpen-detail.jpg"
            alt="Techniker justiert das Bedienfeld einer Wärmepumpen-Anlage"
            width="1600"
            height="1200"
            loading="lazy"
          />
          <div class="service-tile__tint" aria-hidden="true"></div>
          <span class="service-tile__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 9h13m0 0-3-3m3 3-3 3" stroke="var(--error-500)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 15H7m0 0 3 3m-3-3 3-3" stroke="var(--color-brand-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
        <div class="service-tile__body">
          <h3 class="text-lg font-semibold">Wärmepumpen</h3>
          <p class="mt-2 text-slate-600">Beratung, Planung und Installation energieeffizienter Wärmepumpen.</p>
        </div>
      </a>

      <!-- Klimaanlagen card -->
      <a href="/leistungen/klimaanlagen" class="reveal service-tile block">
        <div class="service-tile__media">
          <img
            src="/images/klimaanlagen-detail.jpg"
            alt="Außeneinheit einer Klimaanlage an einer Hauswand"
            width="1600"
            height="1067"
            loading="lazy"
          />
          <div class="service-tile__tint" aria-hidden="true"></div>
          <span class="service-tile__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="var(--cyan-500)" stroke-width="1.6" stroke-linecap="round">
              <path d="M12 3v18"/>
              <path d="M4.5 7.5l15 9"/>
              <path d="M19.5 7.5l-15 9"/>
              <path d="M12 3l-2 2M12 3l2 2"/>
              <path d="M12 21l-2-2M12 21l2-2"/>
              <path d="M4.5 7.5l2.7-.7M4.5 7.5l.7 2.7"/>
              <path d="M19.5 16.5l-2.7.7M19.5 16.5l-.7-2.7"/>
              <path d="M19.5 7.5l-2.7.7M19.5 7.5l-.7 2.7"/>
              <path d="M4.5 16.5l2.7-.7M4.5 16.5l.7-2.7"/>
            </svg>
          </span>
        </div>
        <div class="service-tile__body">
          <h3 class="text-lg font-semibold">Klimaanlagen</h3>
          <p class="mt-2 text-slate-600">Planung und Einbau von Klimaanlagen für Wohn- und Gewerberäume.</p>
        </div>
      </a>

      <!-- Photovoltaik card -->
      <a href="/leistungen/photovoltaik" class="reveal service-tile block">
        <div class="service-tile__media">
          <img
            src="/images/leistungen-photovoltaik.jpg"
            alt="Monteur mit Bauplan auf einem Dach mit Photovoltaik-Anlage"
            width="1400"
            height="933"
            loading="lazy"
          />
          <div class="service-tile__tint" aria-hidden="true"></div>
          <span class="service-tile__badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#facc15" stroke-width="1.6">
              <circle cx="12" cy="12" r="3.2" stroke-width="1.8"/>
              <path d="M12 2v2" stroke-linecap="round"/>
              <path d="M12 20v2" stroke-linecap="round"/>
              <path d="M4.93 4.93l1.41 1.41" stroke-linecap="round"/>
              <path d="M17.66 17.66l1.41 1.41" stroke-linecap="round"/>
              <path d="M2 12h2" stroke-linecap="round"/>
              <path d="M20 12h2" stroke-linecap="round"/>
              <path d="M4.93 19.07l1.41-1.41" stroke-linecap="round"/>
              <path d="M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
            </svg>
          </span>
        </div>
        <div class="service-tile__body">
          <h3 class="text-lg font-semibold">Photovoltaik (PV)</h3>
          <p class="mt-2 text-slate-600">Konzeption und Installation von PV-Anlagen zur eigenen Stromerzeugung.</p>
        </div>
      </a>

    </div>
  </main>
</Layout>

<style>
  .service-tile {
    background: var(--color-bg-surface);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-default);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .service-tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .service-tile__media {
    position: relative;
    height: 11rem;
    overflow: hidden;
  }

  .service-tile__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .service-tile:hover .service-tile__media img {
    transform: scale(1.06);
  }

  .service-tile__tint {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
  }

  .service-tile__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-default);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .service-tile__badge svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .service-tile__body {
    padding: 1.25rem;
  }
</style>
