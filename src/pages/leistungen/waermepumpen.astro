---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Wärmepumpen | Beispiel Heizungsbau GmbH">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <a href="/leistungen" class="text-sm text-slate-600 hover:underline">← Zurück zur Übersicht</a>

    <div class="mt-6 reveal">
      <h1>Wärmepumpen</h1>
      <p class="mt-3 text-slate-600">Detaillierte Informationen zu Wärmepumpen (Beratung, Einbau, Wartung).</p>
    </div>

    <!-- Hero image - replace with client photo if available -->
    <div class="mt-8 reveal">
      <img src="https://images.unsplash.com/photo-1581092580496-58f5f86d7b3b?auto=format&fit=crop&w=1600&q=80" alt="Wärmepumpen Installation" class="w-full h-72 object-cover rounded-2xl shadow-soft-lg" />
    </div>

    <section class="mt-8 reveal">
      <h2>Unsere Leistungen bei Wärmepumpen</h2>
      <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
        <li>Standortanalyse und Systemauslegung</li>
        <li>Fördermittelberatung (BAFA / KfW)</li>
        <li>Installation und Inbetriebnahme</li>
        <li>Wartung und Service</li>
      </ul>
      <p class="mt-4">Kontaktieren Sie uns für ein unverbindliches Angebot.</p>
    </section>
  </main>
</Layout>
