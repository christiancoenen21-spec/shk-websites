---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Wärmepumpen | Beispiel Heizungsbau GmbH">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <a href="/leistungen" class="text-sm text-slate-600 hover:underline">← Zurück zur Übersicht</a>

    <div class="mt-6 reveal flex items-center gap-4">
      <span class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 9h13m0 0-3-3m3 3-3 3" stroke="var(--error-500)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 15H7m0 0 3 3m-3-3 3-3" stroke="var(--color-brand-primary)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <h1>Wärmepumpen</h1>
    </div>
    <p class="mt-3 text-slate-600 reveal">Detaillierte Informationen zu Wärmepumpen (Beratung, Einbau, Wartung).</p>

    <!-- Hero image -->
    <div class="mt-8 reveal">
      <img src="/images/waermepumpen-detail.jpg" alt="Techniker justiert das Bedienfeld einer Wärmepumpen-Anlage" width="1600" height="1200" class="w-full h-72 object-cover rounded-2xl shadow-soft-lg" />
    </div>

    <section class="mt-8 reveal">
      <h2>Unsere Leistungen bei Wärmepumpen</h2>
      <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
        <li>Standortanalyse und Systemauslegung</li>
        <li>Fördermittelberatung (BAFA / KfW)</li>
        <li>Installation und Inbetriebnahme</li>
        <li>Wartung und Service</li>
      </ul>
      <p class="mt-4">Kontaktieren Sie uns für ein unverbindliches Angebot.</p>
    </section>
  </main>
</Layout>

<style>
  .detail-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-default);
  }

  .detail-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
