---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Klimaanlagen | Beispiel Heizungsbau GmbH">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <a href="/leistungen" class="text-sm text-slate-600 hover:underline">← Zurück zur Übersicht</a>

    <div class="mt-6 reveal flex items-center gap-4">
      <span class="detail-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="var(--cyan-500)" stroke-width="1.6" stroke-linecap="round">
          <path d="M12 3v18"/>
          <path d="M4.5 7.5l15 9"/>
          <path d="M19.5 7.5l-15 9"/>
          <path d="M12 3l-2 2M12 3l2 2"/>
          <path d="M12 21l-2-2M12 21l2-2"/>
          <path d="M4.5 7.5l2.7-.7M4.5 7.5l.7 2.7"/>
          <path d="M19.5 16.5l-2.7.7M19.5 16.5l-.7-2.7"/>
          <path d="M19.5 7.5l-2.7.7M19.5 7.5l-.7 2.7"/>
          <path d="M4.5 16.5l2.7-.7M4.5 16.5l.7-2.7"/>
        </svg>
      </span>
      <h1>Klimaanlagen</h1>
    </div>
    <p class="mt-3 text-slate-600 reveal">Planung und Einbau von Klimaanlagen für Wohn- und Gewerberäume.</p>

    <!-- Hero image -->
    <div class="mt-8 reveal">
      <img src="/images/klimaanlagen-detail.jpg" alt="Außeneinheit einer Klimaanlage an einer Hauswand" width="1600" height="1067" class="w-full h-72 object-cover rounded-2xl shadow-soft-lg" />
    </div>

    <section class="mt-8 reveal">
      <h2>Unsere Leistungen bei Klimaanlagen</h2>
      <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
        <li>Beratung und Systemauswahl</li>
        <li>Installation und Wartung</li>
        <li>Serviceverträge und Notdienst</li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .detail-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-bg-surface);
    box-shadow: var(--shadow-default);
  }

  .detail-icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
