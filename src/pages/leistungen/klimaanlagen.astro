---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Klimaanlagen | Beispiel Heizungsbau GmbH">
  <main class="max-w-6xl mx-auto px-6 py-16">
    <a href="/leistungen" class="text-sm text-slate-600 hover:underline">← Zurück zur Übersicht</a>

    <div class="mt-6 reveal">
      <h1>Klimaanlagen</h1>
      <p class="mt-3 text-slate-600">Planung und Einbau von Klimaanlagen für Wohn- und Gewerberäume.</p>
    </div>

    <!-- Hero image - replace with client photo if available -->
    <div class="mt-8 reveal">
      <img src="https://images.unsplash.com/photo-1524758631624-e2822e304c36?auto=format&fit=crop&w=1600&q=80" alt="Klimaanlage" class="w-full h-72 object-cover rounded-2xl shadow-soft-lg" />
    </div>

    <section class="mt-8 reveal">
      <h2>Unsere Leistungen bei Klimaanlagen</h2>
      <ul class="mt-4 list-disc list-inside text-slate-700 space-y-2">
        <li>Beratung und Systemauswahl</li>
        <li>Installation und Wartung</li>
        <li>Serviceverträge und Notdienst</li>
      </ul>
    </section>
  </main>
</Layout>
