---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Aktuelles | Beispiel Heizungsbau GmbH">
  <section class="max-w-6xl mx-auto px-6 py-12">
    <div class="reveal">
      <h1 class="text-3xl font-extrabold">Aktuelles</h1>
      <p class="mt-2 text-slate-600">Neuigkeiten, Projekt‑Updates und Hinweise aus unserem Betrieb.</p>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <article class="bg-white rounded-2xl p-6 shadow-soft-lg reveal">
        <time class="text-xs text-slate-400">10. Juli 2026</time>
        <h3 class="mt-2 text-xl font-semibold">Neue Wärmepumpen‑Installation abgeschlossen</h3>
        <p class="mt-2 text-slate-600">Abgeschlossenes Einfamilienhausprojekt in Bochum mit Luft/Wasser‑Wärmepumpe.</p>
        <a href="#" class="inline-block mt-4 text-sm text-brand-primary">Mehr erfahren →</a>
      </article>

      <article class="bg-white rounded-2xl p-6 shadow-soft-lg reveal">
        <time class="text-xs text-slate-400">1. Juli 2026</time>
        <h3 class="mt-2 text-xl font-semibold">Service‑Einsätze im Juli</h3>
        <p class="mt-2 text-slate-600">Wir erinnern Kunden mit Wärmepumpen an die jährliche Wartung — Termine verfügbar.</p>
        <a href="#" class="inline-block mt-4 text-sm text-brand-primary">Mehr erfahren →</a>
      </article>
    </div>
  </section>
</Layout>
